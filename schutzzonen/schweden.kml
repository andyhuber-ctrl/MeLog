    <Placemark>
      <name>Träskö Storö östra</name>
      <styleUrl>#style_gelb</styleUrl>
      <description><![CDATA[<b>Land:</b> Schweden<br/><b>Schonzeit(en):</b> 1. April – 15. Juni<br/><b>Regeln (Freizeitfischerei):</b><br/><b>VERBOT</b> (FIFS 2004:36): Jegliche Fischerei ist vom 1. April bis zum 15. Juni verboten.<br/><b>Quelle:</b> Länsstyrelserna/Havs- och vattenmyndigheten – Svenska Fiskeregler (svenskafiskeregler.se), GraphQL-Regelwerk]]></description>
      <Polygon><tessellate>1</tessellate><outerBoundaryIs><LinearRing><coordinates>18.826290,59.455560,0 18.823410,59.454310,0 18.822650,59.455090,0 18.826420,59.457540,0 18.826170,59.458000,0 18.817500,59.458670,0 18.801830,59.454670,0 18.808450,59.449900,0 18.809500,59.449670,0 18.820000,59.450830,0 18.823000,59.451670,0 18.822890,59.452970,0 18.827030,59.454850,0 18.826290,59.455560,0</coordinates></LinearRing></outerBoundaryIs></Polygon>
