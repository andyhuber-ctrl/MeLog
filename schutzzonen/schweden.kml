    <Placemark>
      <name>Motala ström</name>
      <styleUrl>#style_gelb</styleUrl>
      <description><![CDATA[<b>Land:</b> Schweden<br/><b>Schonzeit(en):</b> 15. März – 30. Mai<br/><b>Regeln (Freizeitfischerei):</b><br/><b>VERBOT</b> (FIFS 2004:37): Jegliche Fischerei ist vom 15. März bis zum 30. Mai verboten<br/><b>Quelle:</b> Länsstyrelserna/Havs- och vattenmyndigheten – Svenska Fiskeregler (svenskafiskeregler.se), GraphQL-Regelwerk]]></description>
      <Polygon><tessellate>1</tessellate><outerBoundaryIs><LinearRing><coordinates>15.039810,58.533440,0 15.037720,58.532910,0 15.039340,58.531460,0 15.043670,58.533500,0 15.044850,58.533310,0 15.045360,58.534220,0 15.042690,58.534380,0 15.039810,58.533440,0</coordinates></LinearRing></outerBoundaryIs></Polygon>
