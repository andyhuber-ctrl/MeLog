<Folder xmlns="http://www.opengis.net/kml/2.2">
    <name>Usedom – Laichschonbezirke (15)</name>
    <Placemark>
      <name>Göschenbrinksfläche</name>
      <styleUrl>#style_gelb</styleUrl>
      <description>&lt;b&gt;Bundesland:&lt;/b&gt; Mecklenburg-Vorpommern (Ostsee)&lt;br/&gt;&lt;b&gt;Region:&lt;/b&gt; Usedom&lt;br/&gt;&lt;b&gt;Kategorie:&lt;/b&gt; Laichschonbezirke&lt;br/&gt;&lt;b&gt;Regel:&lt;/b&gt; Die seeseitige Grenze ist die in die Seekarten eingezeichnete 2 Meter-Tiefenlinie. Die&lt;br&gt;landseitige Grenze ist der Uferverlauf von der Länge 13° 55,80' E bis zur Länge 13° 56,50' E.&lt;br&gt;Durch die von diesen Punkten ausgehenden Senkrechten bis zur 2 Meter-Tiefenlinie wird die&lt;br&gt;Wasserfläche in Ufernähe begrenzt.&lt;br/&gt;&lt;b&gt;Quelle:&lt;/b&gt; fishing-guide-mv.de (Google My Maps), auf Basis KüFVO M-V 2017 – &lt;a href="https://www.lav-mv.de/downloads/KueFVO_2017.pdf"&gt;KüFVO_2017.pdf&lt;/a&gt;. Private, sorgfältig erstellte Fach-Website (kein Amt); Karte ohne Gewähr.</description>
      <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                13.9285226,53.7976591,0
                13.9309341,53.7972674,0
                13.9329594,53.7971291,0
                13.9363659,53.7936078,0
                13.9358013,53.7929112,0
