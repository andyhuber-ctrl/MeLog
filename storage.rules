rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAllowedUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/allowedEmails/$(request.auth.token.email));
    }

    match /photos/{ownerId}/{entryId} {
      allow read: if isAllowedUser()
        && request.auth.uid in firestore.get(/databases/(default)/documents/entries/$(entryId)).data.visibleTo;

      allow write: if isAllowedUser()
        && request.auth.uid == ownerId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isAllowedUser() && request.auth.uid == ownerId;
    }
  }
}
