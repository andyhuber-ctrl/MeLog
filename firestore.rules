rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email));
    }

    match /allowedEmails/{email} {
      allow read: if isAllowedUser();
      allow write: if false; // nur manuell in der Firebase Console pflegen
    }

    match /users/{uid} {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;

      match /private/{docId} {
        allow read, write: if isAllowedUser() && request.auth.uid == uid;
      }
    }

    match /connections/{connId} {
      allow read: if isAllowedUser() && request.auth.uid in resource.data.users;

      allow create: if isAllowedUser()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && connId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAllowedUser()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAllowedUser() && request.auth.uid in resource.data.users;
    }

    match /entries/{entryId} {
      allow read: if isAllowedUser() && request.auth.uid in resource.data.visibleTo;

      allow create: if isAllowedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['privat', 'community', 'familyfriends']
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && (request.resource.data.visibility != 'privat' || request.resource.data.visibleTo.size() == 1);

      allow update: if isAllowedUser()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.visibility in ['privat', 'community', 'familyfriends']
        && request.resource.data.visibleTo is list
        && request.auth.uid in request.resource.data.visibleTo
        && (request.resource.data.visibility != 'privat' || request.resource.data.visibleTo.size() == 1);

      allow delete: if isAllowedUser() && request.auth.uid == resource.data.ownerId;
    }
  }
}
